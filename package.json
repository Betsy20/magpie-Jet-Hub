{
  "name": "magpie-jet-hub",
  "version": "1.0.0",
  "type": "module",
  "description": "把 deepseek-harness-codearts 插件本体（32 个 provider 的路由中枢）原样装进 magpie：内嵌 cordis 容器运行本体，复用其账号池、静默续期、积分选号与本地 OpenAI 兼容网关，凭据直接共用 DSH 的 .credentials.yaml，不依赖 DSH 进程",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "test:all": "node scripts/test-all.mjs --all",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "snapshot": "node scripts/snapshot-models.mjs",
    "console": "node scripts/run-console.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "vendor",
    "page",
    "console",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "deepseek-harness",
    "dsh",
    "providers-hub",
    "plugin",
    "opencode",
    "auth",
    "provider"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "jose": "^6.1.3",
    "undici": "^8.11.2",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Betsy20/magpie-Jet-Hub.git"
  },
  "homepage": "https://github.com/Betsy20/magpie-Jet-Hub#readme",
  "bugs": {
    "url": "https://github.com/Betsy20/magpie-Jet-Hub/issues"
  },
  "upstream": {
    "name": "dsh-providers-hub",
    "repository": "https://github.com/iJetLi/dsh-providers-hub",
    "npm": "deepseek-harness-codearts",
    "npmAliases": [
      "dsh-providers-hub",
      "dsh-codearts-auth"
    ],
    "version": "2.35.261124",
    "note": "vendor/ 是上游源码 commit 3c9918367baf7d26cc09528156c0afaf50849630 的构建产物（npm install 触发 tsc + copy-assets + client/build + sync-bootstrap-lib；上游自己 tsc 有 125 条 TS2345 类型欠账，noEmitOnError 默认 false 所以照样全量 emit）。npm 包 dsh-providers-hub 最新的 2.35.261124 的 gitHead 是 a1bd1124d6a16ef50aa8a3b2ad99e39330beb215，比 master 落后 6 个提交；vendor 不含 README.md / cordis.patch.yml；lib/ 共 1334 个文件，其中 1321 个与上游逐字节一致（按文档「取法」自己构建时；拿 npm 包比是 1320 + 1 个归一化），13 个是本仓补丁（7 类）；gemini-oauth.* 两个常量拆成两段拼接（值相等）。详见 docs/vendor.md"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 8,
    "page": {
      "title": "Jet Hub",
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [
      "providers:list"
    ]
  }
}
