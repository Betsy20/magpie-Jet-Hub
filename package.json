{
  "name": "magpie-jet-hub",
  "version": "1.0.0",
  "type": "module",
  "description": "把 deepseek-harness-codearts 插件本体（25 个 provider 的路由中枢）原样装进 magpie：内嵌 cordis 容器运行本体，复用其账号池、静默续期、积分选号与本地 OpenAI 兼容网关，凭据直接共用 DSH 的 .credentials.yaml，不依赖 DSH 进程",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "vendor",
    "page",
    "console",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "deepseek-harness",
    "dsh",
    "providers-hub",
    "plugin",
    "opencode",
    "auth",
    "provider"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "jose": "^6.1.3",
    "undici": "^8.11.2",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Betsy20/magpie-Jet-Hub.git"
  },
  "homepage": "https://github.com/Betsy20/magpie-Jet-Hub#readme",
  "bugs": {
    "url": "https://github.com/Betsy20/magpie-Jet-Hub/issues"
  },
  "upstream": {
    "name": "dsh-providers-hub",
    "repository": "https://github.com/iJetLi/dsh-providers-hub",
    "npm": "deepseek-harness-codearts",
    "npmAliases": [
      "dsh-providers-hub",
      "dsh-codearts-auth"
    ],
    "version": "2.9.261029",
    "note": "vendor/ 是上游源码 commit 6fa74723d42ff605d1de349589c21a1ac4eb7ba2 的构建产物（npm install 触发 tsc + copy-assets + client/build），比 npm 包 2.9.261029 多 36 个 magicrew 文件、少 README.md / cordis.patch.yml；gemini-oauth.* 两个常量拆成两段拼接（值相等）。详见 docs/vendor.md"
  },
  "magpie": {
    "name": "Jet Hub 聚合路由",
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 8,
    "page": {
      "title": "Jet Hub",
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [
      "providers:list"
    ]
  }
}
